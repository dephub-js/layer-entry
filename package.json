{
  "name": "@dephub/layer-entry",
  "type": "module",
  "version": "1.0.0",
  "description": "Generate typed ESM entry files (`index.js`, `index.d.ts`, and `package.json`) from JSON layer outputs in `@dephub/layer` post-build tasks.",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "scripts": {
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "release": "pnpm publish",
    "docs": "lineo md 'src/**/*.ts' --outFile code.md --outDir temp",
    "test": "node --test",
    "check": "pnpm fmt && pnpm lint && pnpm check-types",
    "check-types": "tsc --noEmit --skipLibCheck",
    "lint": "eslint . --fix --max-warnings 0",
    "fmt": "prettier --write .",
    "clean": "rm -rf dist .layer",
    "prepack": "pnpm check && pnpm build",
    "pack": "pnpm pack",
    "build": "vite build",
    "dev": "vite build -w --mode development"
  },
  "keywords": [
    "cli",
    "entry",
    "node",
    "layer",
    "json-entry",
    "build-tool",
    "typescript",
    "javascript",
    "content-layer",
    "content-build"
  ],
  "author": {
    "name": "Estarlin R",
    "email": "dev@estarlincito.com",
    "url": "https://estarlincito.com"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/dephub-js/layer-entry#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dephub-js/layer-entry.git"
  },
  "bugs": {
    "url": "https://github.com/dephub-js/layer-entry/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dephub/path": "^2.0.0",
    "@dephub/random-letter": "^1.0.0",
    "@dephub/write": "^1.0.4"
  },
  "devDependencies": {
    "@dephub/eslint-ts": "^1.0.5",
    "@dephub/glob": "^1.0.2",
    "@dephub/schema": "^1.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}